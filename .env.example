# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Database Configuration (PostgreSQL / Cloud SQL)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Stripe Payment Configuration
STRIPE_SECRET_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Firebase Client Configuration
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Configurable Security Rate Limiting Thresholds
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_BASE_MS=1000
AUTH_RATE_LIMIT_MAX_DELAY_MS=30000

PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=60

AUTHENTICATED_RATE_LIMIT_WINDOW_MS=900000
AUTHENTICATED_RATE_LIMIT_MAX=150

AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

STRIPE_RATE_LIMIT_WINDOW_MS=900000
STRIPE_RATE_LIMIT_MAX=20

# Better Auth Configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
